{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "shell",
            "command": "javac",
            "args": [
                "-cp",
                "lib/gson-2.10.1.jar",
                "-d",
                ".",
                "dto/*.java",
                "enums/*.java",
                "loader/*.java",
                "repository/*.java",
                "service/*.java",
                "Main.java"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "run",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                ".:lib/gson-2.10.1.jar",
                "Main"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "compile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}